<?xml version="1.0" encoding="utf-8"?>
<!-- Pre-Android-12 splash, and on every version the window background that
     covers the gap between the system splash dismissing and Flutter's first
     frame — which is why the colour must match the app's ground exactly
     rather than approximately.

     No icon layer. The launcher roundel used to be centred here, and a logo
     dropped whole onto a flat panel was the one moment the app looked like
     someone else's asset. The app introduces itself in Flutter now, by
     writing its own name (TideSplashGate / TideWordmark), so everything the
     platform draws beforehand should be nothing but the ground that word gets
     written on. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_background" />
</layer-list>
