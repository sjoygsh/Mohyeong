<?xml version="1.0" encoding="utf-8"?>
<!-- Both parents are Theme.Black even in the non-night folder, and that is not
     a mistake: main.dart hard-wires `themeMode: ThemeMode.dark`, so the app is
     dark on a light-mode phone too. These used to be Theme.Light, which gave
     the window a WHITE background for the frames between the splash dismissing
     and Flutter's first frame — a white flash on the way into a near-black app. -->
<resources>
    <!-- Applied while the process is starting. windowBackground covers the gap
         between the system splash dismissing and the Flutter engine's first
         frame. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Applied once the process has started: the colour behind the Flutter UI
         while it initialises, and behind it while it runs. Pinned to Tide's
         ground rather than ?android:colorBackground, so any moment the
         framework has not painted looks like the app instead of like a hole. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/splash_background</item>
    </style>
</resources>
