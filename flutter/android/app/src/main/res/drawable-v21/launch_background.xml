<?xml version="1.0" encoding="utf-8"?>
<!-- Pre-Android-12 splash: the Mohyeong glyph centred on splash_background,
     matching the Kotlin app (Theme.Tachiyomi.SplashScreen). Android 12+
     ignores this and uses the windowSplashScreen* attrs in values-v31. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_background" />
    <item
        android:width="192dp"
        android:height="192dp"
        android:drawable="@drawable/ic_mihon_splash"
        android:gravity="center" />
</layer-list>
