<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ system splash.

     The icon slot is deliberately EMPTIED here, with a transparent drawable.

     Left unset, the platform falls back to the adaptive launcher icon — the
     모형 roundel. That used to be the intent, but the app now writes its own
     name on the way in (TideSplashGate / TideWordmark), and the roundel
     flashing first only to be replaced by a word a third of a second later is
     two introductions back to back. What is wanted before the word is bare
     ground, so the icon is opted out of rather than restyled.

     Note the standing warning, still true: do NOT put a real drawable here.
     The platform scales whatever you give it to fill the slot and masks the
     result to a circle, and a hand-built layer-list came out several times
     oversized and clipped on both edges (verified on device, twice, including
     with an explicit 288dp canvas). A transparent shape is safe precisely
     because there are no pixels for that treatment to ruin. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_none</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
</resources>
